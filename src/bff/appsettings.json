{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<bff-client-id>",
    "CallbackPath": "/signin-oidc",
    "ClientCredentials": [
      { "SourceType": "SignedAssertionFilePath" }
    ]
  },
  "Bff": {
    "PublicOrigin": "https://<public-host>",
    "ApiBaseUrl": "http://api.obo.svc.cluster.local:8080",
    "ApiScope": "api://<api-client-id>/user_impersonation",
    "BlobContainerUrl": "https://<storage-account>.blob.core.windows.net/spa"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
