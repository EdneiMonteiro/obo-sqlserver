apiVersion: v1
kind: Namespace
metadata:
  name: obo
  labels:
    istio.io/rev: __ISTIO_REVISION__
    pod-security.kubernetes.io/enforce: baseline
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bff
  namespace: obo
  annotations:
    azure.workload.identity/client-id: "__BFF_CLIENT_ID__"
    azure.workload.identity/tenant-id: "__TENANT_ID__"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api
  namespace: obo
  annotations:
    azure.workload.identity/client-id: "__API_CLIENT_ID__"
    azure.workload.identity/tenant-id: "__TENANT_ID__"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bff
  namespace: obo
data:
  AzureAd__TenantId: "__TENANT_ID__"
  AzureAd__ClientId: "__BFF_CLIENT_ID__"
  AzureAd__ClientCredentials__0__SourceType: "SignedAssertionFilePath"
  Bff__PublicOrigin: "https://__PUBLIC_HOST__"
  Bff__ApiBaseUrl: "http://api.obo.svc.cluster.local:8080"
  Bff__ApiScope: "api://__API_CLIENT_ID__/user_impersonation"
  Bff__BlobContainerUrl: "__BLOB_URL__"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: api
  namespace: obo
data:
  AzureAd__TenantId: "__TENANT_ID__"
  AzureAd__ClientId: "__API_CLIENT_ID__"
  AzureAd__Audience: "__API_CLIENT_ID__"
  AzureAd__AllowedClientId: "__BFF_CLIENT_ID__"
  AzureAd__ClientCredentials__0__SourceType: "SignedAssertionFilePath"
  Sql__ConnectionString: "Server=tcp:__SQL_FQDN__,1433;Database=__DATABASE__;Encrypt=True;TrustServerCertificate=False;Column Encryption Setting=Enabled;"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bff
  namespace: obo
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels: { app: bff }
  template:
    metadata:
      labels:
        app: bff
        azure.workload.identity/use: "true"
      annotations:
        checksum/manifest: "__MANIFEST_SHA256__"
        proxy.istio.io/config: '{"holdApplicationUntilProxyStarts":true}'
    spec:
      serviceAccountName: bff
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1654
        fsGroup: 1654
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: bff
          image: __REGISTRY__/obo-bff:__TAG__
          ports: [{ containerPort: 8080 }]
          envFrom: [{ configMapRef: { name: bff } }]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
          resources:
            requests: { cpu: 100m, memory: 256Mi }
            limits: { cpu: "1", memory: 768Mi }
          readinessProbe: { httpGet: { path: /healthz, port: 8080 }, initialDelaySeconds: 5 }
          livenessProbe: { httpGet: { path: /healthz, port: 8080 }, initialDelaySeconds: 30 }
          volumeMounts: [{ name: tmp, mountPath: /tmp }]
      volumes: [{ name: tmp, emptyDir: {} }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: obo
spec:
  replicas: 1
  selector:
    matchLabels: { app: api }
  template:
    metadata:
      labels:
        app: api
        azure.workload.identity/use: "true"
      annotations:
        checksum/manifest: "__MANIFEST_SHA256__"
        proxy.istio.io/config: '{"holdApplicationUntilProxyStarts":true}'
    spec:
      serviceAccountName: api
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1654
        fsGroup: 1654
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: api
          image: __REGISTRY__/obo-api:__TAG__
          ports: [{ containerPort: 8080 }]
          envFrom: [{ configMapRef: { name: api } }]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
          resources:
            requests: { cpu: 100m, memory: 256Mi }
            limits: { cpu: "1", memory: 768Mi }
          readinessProbe: { httpGet: { path: /healthz, port: 8080 }, initialDelaySeconds: 5 }
          livenessProbe: { httpGet: { path: /healthz, port: 8080 }, initialDelaySeconds: 30 }
          volumeMounts: [{ name: tmp, mountPath: /tmp }]
      volumes: [{ name: tmp, emptyDir: {} }]
---
apiVersion: v1
kind: Service
metadata: { name: bff, namespace: obo }
spec:
  selector: { app: bff }
  ports: [{ name: http, port: 8080, targetPort: 8080 }]
---
apiVersion: v1
kind: Service
metadata: { name: api, namespace: obo }
spec:
  selector: { app: api }
  ports: [{ name: http, port: 8080, targetPort: 8080 }]
---
apiVersion: security.istio.io/v1
kind: PeerAuthentication
metadata: { name: strict, namespace: obo }
spec:
  mtls: { mode: STRICT }
---
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy
metadata: { name: api-only-from-bff, namespace: obo }
spec:
  selector:
    matchLabels: { app: api }
  action: ALLOW
  rules:
    - from:
        - source:
            principals: ["cluster.local/ns/obo/sa/bff"]
      to:
        - operation: { ports: ["8080"], methods: ["GET", "POST"] }
---
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy
metadata: { name: bff-only-from-gateway, namespace: obo }
spec:
  selector:
    matchLabels: { app: bff }
  action: ALLOW
  rules:
    - from:
        - source:
            principals: ["cluster.local/ns/aks-istio-ingress/sa/aks-istio-ingressgateway-external"]
      to:
        - operation: { ports: ["8080"], methods: ["GET", "POST"] }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: { name: application-boundary, namespace: obo }
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: aks-istio-ingress } }
        - podSelector: { matchLabels: { app: bff } }
      ports: [{ port: 8080, protocol: TCP }]
  egress:
    - to:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } }
      ports: [{ port: 53, protocol: UDP }, { port: 53, protocol: TCP }]
    - to:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: aks-istio-system } }
      ports: [{ port: 15012, protocol: TCP }]
    - to:
        - podSelector: { matchLabels: { app: api } }
      ports: [{ port: 8080, protocol: TCP }]
    - ports: [{ port: 443, protocol: TCP }]
    - to:
        - ipBlock: { cidr: 10.72.4.0/24 }
      ports: [{ port: 1433, protocol: TCP }, { port: 11000, endPort: 11999, protocol: TCP }]
